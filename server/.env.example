# ---------------------------------------------------------------------------
# Cognito SSO Lab - backend configuration
# Copy to .env and fill in once your Cognito User Pool + App Client exist.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# The frontend origin. Used for CORS and for the post-login redirect.
FRONTEND_URL=http://localhost:5173

# Secret used to sign the app session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cognito - all of these come from the AWS console once the pool is created.
# ---------------------------------------------------------------------------

# OIDC issuer. Tokens are validated against this (iss claim + JWKS lookup).
# Format: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
COGNITO_ISSUER=

# Hosted UI domain. Used for the /authorize, /token and /logout endpoints.
# WITH scheme, NO trailing slash:
#   https://<your-prefix>.auth.<region>.amazoncognito.com
COGNITO_DOMAIN=

# App client credentials (App integration > App clients).
COGNITO_CLIENT_ID=
# Leave blank if the app client was created WITHOUT a secret (public client).
COGNITO_CLIENT_SECRET=

# Must be listed verbatim as an "Allowed callback URL" on the app client.
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# Must be listed verbatim as an "Allowed sign-out URL" on the app client.
# To also end the upstream IdP session, point this at the backend instead and
# set OKTA_ORG_URL below -- see "Ending the Okta session too" further down:
#   COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/logout/idp
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:5173

# Space-separated OAuth scopes to request.
# The app client must allow every scope listed here or /oauth2/authorize fails
# with invalid_scope before the user ever sees a login page.
COGNITO_SCOPES=openid email profile

# ---------------------------------------------------------------------------
# Okta (optional) - only needed to end the Okta session on logout
# ---------------------------------------------------------------------------
# Your Okta ORG url, NOT the admin console. Drop the "-admin":
#     https://integrator-12345678.okta.com          <- this
#     https://integrator-12345678-admin.okta.com    <- not this
# No trailing slash.
#
# Leave it blank and logout stops at Cognito: the app session and the Cognito
# session are cleared, but Okta still recognises the user, so the next login is
# silent and looks like logout did nothing. That is normal OIDC behaviour --
# signing out of one app should not sign you out of every other Okta app -- so
# only set this if you specifically want a global logout.
#
# When set, GET /auth/logout/idp redirects to Okta's /login/signout. Two console
# settings are required for the chain to work:
#   1. Cognito app client -> Allowed sign-out URLs must include
#      http://localhost:3000/auth/logout/idp
#   2. Okta -> Security -> API -> Trusted Origins must include
#      http://localhost:5173 with type "Redirect", or Okta ignores fromURI
OKTA_ORG_URL=

# ---------------------------------------------------------------------------
# Running a second instance (app 2) to demonstrate SSO
# ---------------------------------------------------------------------------
# Copy this file to .env.app2 and run it with `npm run dev:app2`.
#
# MUST be IDENTICAL to app 1 -- both app clients live in the SAME user pool,
# and the shared managed-login domain is where the session cookie lives. That
# cookie IS single sign-on. Point the two apps at different domains and both
# will work perfectly while never signing in silently, with no error to explain
# it:
#     COGNITO_ISSUER
#     COGNITO_DOMAIN
#
# MUST DIFFER:
#     PORT                        3000 -> 3001
#     FRONTEND_URL                http://localhost:5173 -> :5174
#     COGNITO_REDIRECT_URI        .../3000/... -> .../3001/...
#     COGNITO_LOGOUT_REDIRECT_URI http://localhost:5173 -> :5174
#     COGNITO_CLIENT_ID           app2's app client
#     COGNITO_CLIENT_SECRET       app2's app client
#
# Do NOT create a second user pool for app 2. Create a second APP CLIENT inside
# the existing pool. A second pool gives you a second domain, a second cookie
# and a separate user directory -- the symptom is
# `<domain>/error?error=invalid_request` while every console setting looks
# correct, because the client you are inspecting is fine, it is just elsewhere.
#
# Sanity check before you start -- both must print 26:
#     grep -h COGNITO_CLIENT_ID .env .env.app2 | awk -F= '{print length($2), $0}'
