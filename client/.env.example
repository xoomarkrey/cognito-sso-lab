# Base URL of the backend. Must match FRONTEND_URL's counterpart in server/.env.
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Per-instance branding
# ---------------------------------------------------------------------------
# This one codebase runs as several apps at once (app1, app2, ...), each with
# its own Cognito app client in the SAME user pool. These two values are the
# only thing that makes them look different on screen, which keeps the demo
# honest: same code, different configuration.
#
#   client/.env       -> app 1   (npm run dev,      port 5173)
#   client/.env.app2  -> app 2   (npm run dev:app2, port 5174)

# Shown in the ribbon, both page headings and the browser tab.
VITE_APP_NAME=App 1

# Any CSS colour. Drives the ribbon and every accent in the UI.
# NOTE: quote it. '#' starts a comment in .env files, so an unquoted
#       VITE_APP_ACCENT=#2563eb parses as EMPTY and you silently get the
#       default colour. A bare 2563eb (no '#') is also accepted.
VITE_APP_ACCENT="#2563eb"

# Port this instance's dev server listens on. Defaults to 5173 when unset.
# VITE_PORT=5174
